{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CocoindexSnapshots",
      "Effect": "Allow",
      "Principal": {
        "AWS": [
          "arn:aws:iam:::user/ali-bot"
        ]
      },
      "Action": [
        "s3:ListBucket",
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": [
        "arn:aws:s3:::alice-cocoindex",
        "arn:aws:s3:::alice-cocoindex/*"
      ]
    }
  ]
}
