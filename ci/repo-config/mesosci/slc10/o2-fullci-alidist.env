# The alidist half of the slc10 fullCI bring-up; o2-fullci.env beside this one
# does the same for AliceO2 PRs, and carries the reasoning for the move off
# slc9-gpu-builder and for JOBS.

CI_NAME=build_O2_fullCI_alidist_slc10_x86
CHECK_NAME=build/O2/fullCI/alidist-slc10-x86
PACKAGE=O2FullCI
ALIBUILD_DEFAULTS=o2
PR_REPO=alisw/alidist
PR_BRANCH=master
TRUST_COLLABORATORS=true
DONT_USE_COMMENTS=1
DEVEL_PKGS="$PR_REPO $PR_BRANCH
AliceO2Group/AliceO2 dev O2
AliceO2Group/O2Physics master
AliceO2Group/O2DPG master"
ALIBUILD_O2_FORCE_GPU=ci
JOBS=12

# ONLY_PRS is the lever to reach for if this costs too much. The slc9 check
# already runs on every alidist PR, so this one doubles the fullCI load on the
# shared pool from the day it lands -- and fullCI is the longest check there is.
# Set it to a handful of PR numbers to narrow the burn-in (a push, not a
# redeploy: repo-config is re-fetched every round), the way o2-alidist.env was
# pinned to 6299 and 6193 for its own bring-up.
