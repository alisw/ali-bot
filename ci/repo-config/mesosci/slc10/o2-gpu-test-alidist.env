# The GPU check for alidist PRs. o2-gpu-test.env beside this one does the same
# for AliceO2 PRs; this is the missing half, and its absence is why alidist PRs
# touching GPU recipes had to be PINNED into the O2 check instead. That pin froze
# the recipes for three weeks in September 2026 -- see the pin history in
# o2-gpu-test.env. A recipe change now has somewhere of its own to be proven.
#
# This is the only place gpu-system.sh is built with the GPU actually enabled.

# ONLY FOR RECIPES THAT CAN AFFECT THE GPU BUILD. The gpu pool is one worker, so
# running this on every alidist PR would make it the fleet's bottleneck; the
# queue is shared, and a full O2-GPU-test round is hours.
#
# git pathspec, NOT a shell glob. build-loop.sh word-splits this unquoted, so
# bash expands any pattern that matches in the checkout BEFORE git sees it --
# turning a pathspec into "whatever exists right now". `:(icase)` can match no
# filename, so bash leaves it alone and git applies it, case-insensitively and
# as a substring. Writing `*gpu*` here instead would be silently shell-expanded
# and case-sensitive: it misses GPUtracking.sh and O2-GPU-test.sh.
#
# The glob already covers gpu-system.sh, o2-gpu-test.sh, o2-gpu-deterministic-
# test.sh and o2gpuci.sh, so only the two recipes without "gpu" in the name are
# listed. Verified against a scratch repo before committing.
ONLY_RUN_WHEN_CHANGED='o2.sh onnxruntime.sh :(icase)*gpu*'

CI_NAME=build_O2_alidist_gpu_test_slc10_x86
CHECK_NAME=build/O2/alidist-gpu-test-slc10-x86
PR_REPO=alisw/alidist
PR_BRANCH=master

# O2-GPU-test, not o2-gpu-test: aliBuild keys on the `package:` field inside the
# recipe, not the filename. Getting it wrong fails in aliBuild doctor and is
# reported as the generic "aliBuild doctor error".
PACKAGE=O2-GPU-test
ALIBUILD_DEFAULTS=o2

# The alidist PR under test, built against current O2 dev -- same shape as
# o2-alidist.env beside this one.
DEVEL_PKGS="$PR_REPO $PR_BRANCH
AliceO2Group/AliceO2 dev O2"

# Mirrored from o2-gpu-test.env: without these the recipe builds a CPU-only
# O2-GPU-test and proves nothing.
ALIBUILD_O2_FORCE_GPU=build
ALIBUILD_O2_FORCE_GPU_CUDA_ARCH="120"
ALIBUILD_O2_FORCE_GPU_HIP_ARCH="gfx906"
DOCKER_EXTRA_ARGS='--tmpfs=/dev/shm:rw,size=10g,mode=1777 --cap-add=PERFMON --cap-add=IPC_LOCK --device amd.com/gpu=all --device nvidia.com/gpu=all'
REQUIRES_POOL=gpu
POOL_PRIORITY="gpu=10"
JOBS=12

# slc10 tarballs live in alibuild-cas, but the legacy tree in alibuild-repo is
# the one still being written to; see o2-alidist.env for the full reasoning.
REMOTE_STORE=https://s3.cern.ch/swift/v1/alibuild-repo
NO_ASSUME_CONSISTENT_EXTERNALS=
TRUST_COLLABORATORS=true
DONT_USE_COMMENTS=1
