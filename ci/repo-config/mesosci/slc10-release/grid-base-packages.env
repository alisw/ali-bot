# grid-base-packages for slc10, so CVMFS can have it: the GCC-Toolchain
# modulefile prereqs grid-base-packages/default, and nothing is loadable on
# el10-x86_64 until it is published. It has never been built for slc10 --
# TARS/slc10_x86-64/dist-direct/grid-base-packages/ is empty, while slc9 has
# v1-1 -- so this exists to produce it rather than to release it repeatedly.
#
# A seconds-long build: the recipe only runs alibuild-generate-module, and both
# its dependencies (jq, alibuild-recipe-tools) are already in the CAS from the
# slc10 PR builds, so they download rather than build.
#
# Cut the tag by hand on alidist, e.g.
#   git tag grid-base-packages-v1-20261013 && git push origin grid-base-packages-v1-20261013
# Any commit will do: the version is fixed at v1 by the recipe, so the tag only
# says WHICH day's build to make. The v[0-9] in the name is for humans and for
# the day the recipe's version moves; TAG_ver is exported but unused.
CI_NAME=build_grid_base_packages_slc10
PACKAGE=grid-base-packages
PR_REPO=alisw/alidist
PR_BRANCH=master
# Same defaults as the slc10 PR checks, so the dependency tarballs already in
# alibuild-cas are hits rather than rebuilds.
ALIBUILD_DEFAULTS=o2
# %(date) is required by list-release-tags -- without it the regex would match
# every tag of this shape ever cut, and alidist carries >10000 tags. The leading
# literal "grid-base-packages-" is what GitHub filters on.
TAG_REGEX='^grid-base-packages-(?P<ver>v[0-9]+)-%(date)(?P<variant>-[0-9]{4})?$'
CHECK_NAME=release/grid-base-packages/slc10-x86
# Today and yesterday. The tag will be cut by hand, so a worker that was busy
# or down when it landed should still pick it up; the tag's GitHub status is
# what stops it being built twice.
RELEASE_LOOKBACK_DAYS=1
DONT_USE_COMMENTS=1

# REBUILD_TAGS deliberately NOT set. Set it to this tag's name, temporarily, to
# re-run one that is already green -- cheap, because the tarballs come back out
# of the store.
