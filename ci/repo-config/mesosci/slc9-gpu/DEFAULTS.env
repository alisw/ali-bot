# Per container, because one worker serves several (CUR_CONTAINERS in
# ci-linux-x86.nomad). Plain assignments, so they win over whatever the job
# exported for the container it happened to start with.
#
# slc9-GPU-builder, not slc9-builder. The legacy Levant job derived the image
# from the pool name -- ci/ci.nomad line 207,
# CONTAINER_IMAGE=registry.cern.ch/alisw/[[ $.arch ]]-builder:latest with
# arch: slc9-gpu -- so these seven checks have only ever been built in that
# image, and it carries the GPU toolchain that o2-fullci.env's
# ALIBUILD_O2_FORCE_GPU=ci needs. Both images exist in the registry, which is
# exactly why the wrong one would fail late and confusingly rather than at pull.
ARCHITECTURE=slc9_x86-64
CONTAINER_IMAGE=registry.cern.ch/alisw/slc9-gpu-builder:latest

# WHY THIS POOL MOVED HERE (2026-09-06).
#
# On the Levant job these builds OOM-killed constantly, always in PWGJE/Tasks,
# on three different hosts at unrelated times:
#
#     c++: fatal error: Killed signal terminated program cc1plus
#
# The cause was not the node and not the build. O2Physics sizes its `analysis`
# ninja JOB_POOL from the memory it can see, preferring the cgroup limit because
# cmake_host_system_information reports the HOST. In the legacy container the
# cgroup was NOT visible, so it read the host's 251 GiB and computed
#
#     (257000 - 2048) / 8192 = 31 parallel analysis compilations
#
# at ~8 GiB each -- roughly 248 GB of intent inside a container capped at
# ~121 GB. On this job the cgroup IS read:
#
#     Memory limit from /sys/fs/cgroup/memory/memory.limit_in_bytes: 106496 MiB
#     Limiting workflow compilations in parallel to: 12
#
# and the same builds do not OOM. That difference, not the extra workers, is the
# reason to move.
#
# So if these checks start OOM-killing again, do NOT reach for JOBS first: check
# the pool actually bound, by looking for "Limiting workflow compilations in
# parallel to:" in the O2Physics configure output. A missing line, or a pool
# near 31, means the container stopped seeing its cgroup and the budget is
# fiction again.

# 24, matching the CPU entitlement of a ci-linux-x86 allocation (cores = 24) --
# see the long note in slc10/DEFAULTS.env for why JOBS has to track the
# allocation and not the node's 64 logical CPUs. Inherited from
# mesosci/DEFAULTS.env today, restated here so a resize of the shared default
# does not silently retune this pool.
JOBS=24
