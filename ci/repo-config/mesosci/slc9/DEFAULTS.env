USE_RECC=1

# ci-linux-x86 serves seven containers but derives ARCHITECTURE once, from its
# job-wide CUR_CONTAINER=slc10. Unset here, every round of this container built
# as slc10_x86-64 in the slc10 image and wrote slc10 trees into the slc9 work
# area; see the other containers' DEFAULTS.env, which all set both.
ARCHITECTURE=slc9_x86-64
CONTAINER_IMAGE=registry.cern.ch/alisw/slc9-builder:latest
