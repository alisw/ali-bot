# Per container, because one worker serves several (CUR_CONTAINERS in
# ci-linux-x86.nomad). Plain assignments, so they win over whatever the job
# exported for the container it happened to start with.
#
# The directory name IS the container name: claim-builder.sh sets
# CUR_CONTAINER from the "<container>/<env>" key it stamps on each row, and
# ci-linux-x86.nomad sets ALIBOT_CONFIG_SUFFIX="", so source_env_files resolves
# repo-config/mesosci/slc9-staging/ directly. The retired Levant job reached the
# same directory a different way -- CUR_CONTAINER=slc9 plus
# ALIBOT_CONFIG_SUFFIX=-staging -- which is why no files had to move.
#
# slc9-builder, matching what ci/ci.nomad line 207 derived for this pool
# (registry.cern.ch/alisw/[[ $.arch ]]-builder:latest with arch: slc9). NOT
# slc9-gpu-builder: this check has no GPU step, and the GPU image only differs
# by carrying a toolchain it would never use.
ARCHITECTURE=slc9_x86-64
CONTAINER_IMAGE=registry.cern.ch/alisw/slc9-builder:latest

# 24, matching a ci-linux-x86 allocation's CPU entitlement (cores = 24) rather
# than the 32 the Levant job exported for a machine it had to itself. See the
# long note in slc10/DEFAULTS.env for why JOBS has to track the allocation and
# not the node's 64 logical CPUs -- asking for more than the entitlement buys
# throttling, not parallelism.
#
# Inherited from mesosci/DEFAULTS.env today, restated here so a change to the
# shared default does not silently retune this pool.
JOBS=24
