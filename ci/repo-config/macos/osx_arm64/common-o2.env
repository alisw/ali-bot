# Moved from macos/aido2osx7/ so the claim-based ci-macos-arm serves it;
# osx_arm64 is already in that job's CUR_CONTAINERS, so no jobspec change.
# Settings are unchanged: neither container dir has a DEFAULTS.env.
CI_NAME=common_checker_macos_arm_o2_ci
PR_REPO=AliceO2Group/Common
PR_BRANCH=master
PACKAGE=O2
CHECK_NAME=build/Common/O2/o2/macOS-arm
ALIBUILD_DEFAULTS=o2
DONT_USE_COMMENTS=1
DEVEL_PKGS="$PR_REPO $PR_BRANCH $PR_REPO_CHECKOUT
alisw/alidist master"
