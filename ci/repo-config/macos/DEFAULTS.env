TRUSTED_USERS=ktf,singiamtel
TRUST_COLLABORATORS=true
REMOTE_STORE=
DOCKER_EXTRA_ARGS=
USE_RECC=1
# Not passed to aliBuild here (no docker, so it detects the architecture
# itself); it only labels the round and memory metrics in build-helpers.sh and
# build-loop.sh, which otherwise report arch="unknown". Both container dirs
# (osx_arm64, staging) run on the arm Macs.
ARCHITECTURE=osx_arm64
