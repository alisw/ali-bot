#!/usr/bin/env python

from argparse import ArgumentParser
import logging
import sys

from alibot_helpers.github_utilities import (
    setGithubStatus, githubStateLine, GithubCachedClient, StatusLimitReached)


# Just for the moment
DEFAULT_REPO = "alibuild"
DEFAULT_USER = "alisw"


def parse_args():
    usage = "set-github-status "
    usage += "[-d] [-n] -c <commit> -s <status> [-m <status-message>] [-u <target-url> | -k]"
    usage += "\n       set-github-status -c <commit> --print-state --context <context>"
    parser = ArgumentParser(usage=usage)
    parser.add_argument("--commit", "-c",
                        required=True,
                        help=("Commit that the status refers to, in "
                              "<org>/<project>@<ref> format"))

    parser.add_argument("--status", "-s",
                        help="Status to set in <status-id>/<status> format")

    parser.add_argument("--print-state", action="store_true",
                        help=("Change nothing; print the newest status of "
                              "--context as STATE CREATED ID, CREATED in "
                              "seconds since the epoch, '-' if unknown, or "
                              "'none - -' if there is none"))
    parser.add_argument("--context",
                        help="Context for --print-state, e.g. build/O2/fullCI")

    parser.add_argument("--message", "-m",
                        default="",
                        help="Message relative to the status (default='')")

    url = parser.add_mutually_exclusive_group()
    url.add_argument("--url", "-u", default="",
                     help="Target URL for the report (default=%(default)s)")
    url.add_argument("--keep-url", "-k", action="store_true",
                     help="Copy the target URL from the existing status.")

    parser.add_argument("--debug", "-d",
                        action="store_true",
                        default=False,
                        help="Target url for the report")

    parser.add_argument("--dry-run", "-n",
                        action="store_true",
                        dest="dryRun",
                        default=False,
                        help="Dry run. Do not actually modify the state")

    args = parser.parse_args()
    if args.print_state and not args.context:
        parser.error("--print-state needs --context")
    if not args.print_state and not args.status:
        parser.error("the following arguments are required: --status/-s")

    if args.debug:
        logger = logging.getLogger()
        logger.setLevel(logging.DEBUG)

    return args



def main():
    args = parse_args()
    if args.print_state:
        # One line on stdout, or one on stderr and exit 1. build-one.sh builds
        # unless the line says otherwise, so no traceback is worth more.
        try:
            with GithubCachedClient() as cgh:
                print(githubStateLine(cgh, args.commit, args.context))
        except Exception as e:
            print("set-github-status: cannot read %s on %s: %s" %
                  (args.context, args.commit, e), file=sys.stderr)
            sys.exit(1)
        sys.exit(0)

    if args.dryRun:
        print("Dry run specified. Not executing")
        sys.exit(0)

    with GithubCachedClient() as cgh:
        try:
            setGithubStatus(cgh, args)
        except StatusLimitReached as e:
            # Exit 3, not 1: this can never succeed, so a caller that retries or
            # goes on to build is wasting its time. See the exception's docstring.
            print(e, file=sys.stderr)
            sys.exit(3)
        except RuntimeError as e:
            # `e.message` has not existed since Python 2, so this handler used to
            # raise AttributeError and lose the original error.
            print(e, file=sys.stderr)
            sys.exit(1)
        finally:
            cgh.printStats()

    sys.exit(0)


if __name__ == "__main__":
    main()
